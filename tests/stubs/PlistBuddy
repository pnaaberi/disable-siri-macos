#!/usr/bin/env python3
"""Test double for PlistBuddy -c 'Print :KEY' FILE on files written by the defaults stub."""
import json
import sys

command, path = sys.argv[2], sys.argv[3]
assert sys.argv[1] == '-c' and command.startswith('Print :'), sys.argv
key = command[len('Print :'):]
data = json.loads(open(path).read())
if key not in data:
    print(f'Print: Entry, ":{key}", Does Not Exist', file=sys.stderr)
    sys.exit(1)
items = data[key]
print('Array {\n' + ''.join(f'    {item}\n' for item in items) + '}' if items else 'Array {\n}')
